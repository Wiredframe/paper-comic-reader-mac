    "Choose Library Folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheksordner wählen …"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cartella della libreria…"
          }
        }
      }
    },
    "Choose a library backup from Paper Comic on the Mac, iPhone or iPad. Reading progress, favorites and bookmarks are merged into this library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Bibliotheks-Backup von Paper Comic auf Mac, iPhone oder iPad. Lesestand, Favoriten und Lesezeichen werden in diese Bibliothek übernommen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un backup della libreria di Paper Comic su Mac, iPhone o iPad. Progressi, preferiti e segnalibri vengono uniti a questa libreria."
          }
        }
      }
    },
    "Choose the Comic’s File…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei des Comics wählen …"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il file del fumetto…"
          }
        }
      }
    },
    "Choose the file of “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Datei von „%@“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il file di «%@»."
          }
        }
      }
    },
    "Choose the folder that holds your comics, or import CBZ files. Covers and details are read in; a comic from the library folder is downloaded when you open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit deinen Comics oder importiere CBZ-Dateien. Cover und Details werden eingelesen; ein Comic aus dem Bibliotheksordner wird geladen, wenn du ihn öffnest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella con i tuoi fumetti o importa file CBZ. Copertine e dettagli vengono letti subito; un fumetto della cartella viene scaricato quando lo apri."
          }
        }
      }
    },
    "Choose the folder that holds your comics. Covers and details are read in; each comic is downloaded when you open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit deinen Comics. Cover und Details werden eingelesen; jeder Comic wird geladen, wenn du ihn öffnest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella con i tuoi fumetti. Copertine e dettagli vengono letti subito; ogni fumetto viene scaricato quando lo apri."
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen …"
          }
        },
        "it": {
