    "Clear the list of recent comics. The comics stay in the library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert den Verlauf. Die Comics bleiben in der Bibliothek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota l’elenco dei fumetti recenti. I fumetti restano nella libreria."
          }
        }
      }
    },
    "Click the left or right edge to turn pages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Klick auf den linken oder rechten Rand blättern"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia con un clic sul bordo sinistro o destro"
          }
