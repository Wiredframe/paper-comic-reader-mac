    "%lld comics came back without their files and can’t be opened until you import them again.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Comic kam ohne seine Datei zurück und lässt sich erst öffnen, wenn du ihn erneut importierst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Comics kamen ohne ihre Dateien zurück und lassen sich erst öffnen, wenn du sie erneut importierst."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld comic came back without its file and can’t be opened until you import it again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld comics came back without their files and can’t be opened until you import them again."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fumetto è tornato senza il suo file e non si può aprire finché non lo importi di nuovo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fumetti sono tornati senza i loro file e non si possono aprire finché non li importi di nuovo."
                }
              }
            }
          }
        }
      }
    },
