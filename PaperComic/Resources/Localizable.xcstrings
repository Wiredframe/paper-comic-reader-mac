    },
    "Covers and details are read from the folder. A comic is downloaded when you open it and can be removed again to save space; it stays in the library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover und Details werden aus dem Ordner gelesen. Ein Comic wird beim Öffnen geladen und kann wieder entfernt werden, um Platz zu sparen; er bleibt in der Bibliothek."
          }
        },
        "it": {
          "stringUnit": {
